# Production Environment Variables for Rockdrill Frontend
# READY FOR RAILWAY BACKEND CONNECTION

# Demo Mode Configuration
# Set to false when Railway backend is deployed
VITE_DEMO_MODE=true

# API Configuration
# UPDATE THESE AFTER RAILWAY DEPLOYMENT:
# VITE_API_URL=https://your-backend.railway.app/api/v1
# VITE_API_BASE_URL=https://your-backend.railway.app
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000

# Environment
VITE_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_FEATURES=true

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_FEATURES=true

# External Services (Optional - configure in Vercel dashboard)
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# VITE_SENTRY_DSN=your-sentry-dsn

# Build Configuration
NODE_ENV=production
