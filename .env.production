# Production Environment Variables for Rockdrill

# Demo Mode Configuration
VITE_DEMO_MODE=true

# API Configuration
# Note: Since backend is not deployed, demo mode will be automatically enabled
# VITE_API_URL=https://your-backend-api.herokuapp.com/api/v1
# VITE_API_BASE_URL=https://your-backend-api.herokuapp.com

# Environment
VITE_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_FEATURES=true

# External Services (Optional - configure in Vercel dashboard)
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# VITE_SENTRY_DSN=your-sentry-dsn

# Build Configuration
NODE_ENV=production
