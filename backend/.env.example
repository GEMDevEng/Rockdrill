# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/rockdrill_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rockdrill_db
DATABASE_USER=username
DATABASE_PASSWORD=password

# Redis Configuration (for caching and task queue)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Rockdrill API
PROJECT_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://rockdrill-rnzl5r01q-gem-devs-projects.vercel.app"]

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@rockdrill.com
FROM_NAME=Rockdrill

# External API Keys
CLEARBIT_API_KEY=your-clearbit-api-key
CLAY_API_KEY=your-clay-api-key
ZOOMINFO_API_KEY=your-zoominfo-api-key

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=["csv", "xlsx", "xls"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
