# Staging Environment Variables for Rockdrill Backend

# Application Configuration
ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=DEBUG

# Database Configuration (Railway will provide DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:port/database

# Security Configuration (Use different keys for staging)
# SECRET_KEY=staging-secret-key-different-from-production
# ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=6

# CORS Configuration (Allow more origins for testing)
# BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://staging.rockdrill.com"]

# External Services (Use test/sandbox accounts)
# SENDGRID_API_KEY=staging-sendgrid-api-key
# REDIS_URL=redis://localhost:6379/1

# Monitoring and Logging
# SENTRY_DSN=staging-sentry-dsn
# DATADOG_API_KEY=staging-datadog-api-key

# Rate Limiting (More lenient for testing)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20

# File Upload
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=["csv", "xlsx", "json", "txt"]

# Email Configuration
EMAIL_FROM_NAME="Rockdrill Staging"
EMAIL_FROM_ADDRESS="staging@rockdrill.com"

# Feature Flags (Enable all features for testing)
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_ANALYTICS=true

# API Configuration
API_V1_STR="/api/v1"
PROJECT_NAME="Rockdrill API (Staging)"
PROJECT_VERSION="1.0.0-staging"
