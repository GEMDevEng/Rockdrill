# Production Environment Variables Template for Rockdrill Frontend
# Copy this file to .env.production and update the values

# Demo Mode Configuration
# Set to false for production deployment with real backend
VITE_DEMO_MODE=false

# API Configuration
# Update this URL to your deployed Railway backend
VITE_API_URL=https://your-backend.railway.app/api/v1
VITE_API_BASE_URL=https://your-backend.railway.app

# Environment
VITE_ENVIRONMENT=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_FEATURES=true

# External Services (Optional - configure in Vercel dashboard)
# VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
# VITE_SENTRY_DSN=your-sentry-dsn

# Build Configuration
NODE_ENV=production

# Security Headers (handled by vercel.json)
# These are informational - actual configuration is in vercel.json

# Performance Monitoring
# VITE_PERFORMANCE_MONITORING=true

# Error Tracking
# VITE_ERROR_TRACKING=true
